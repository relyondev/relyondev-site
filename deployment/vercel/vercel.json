{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "methods": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "dest": "/api/route"
    },
    {
      "src": "/(_next/image|content/(?:page|site-builder|homepage|project-titles|post-cards|preview-image/\\d+|builder-section/\\d+))",
      "dest": "/api/route?__route=/$1"
    },
    {
      "src": "/?",
