        "__component": "sections.faq",
        "heading": "Frequently Asked Questions",
        "items": [
          {
            "question": "How do I get started with Relyon Dev?",
            "answer": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Simply fill out the contact form, and we’ll reach out through email or WhatsApp based on your preferred method of communication."
                  }
                ]
              }
            ]
          },
          {
            "question": "How involved do I need to be during the project?",
            "answer": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "You only need to share your content, preferences, and feedback at important stages. We handle the complete design, development, testing, and launch process."
                  }
                ]
              }
            ]
          },
          {
            "question": "How long does it take to build a website?",
            "answer": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Most websites are completed within 2–6 weeks, depending on the number of pages, design direction, and required features."
                  }
                ]
              }
            ]
          },
          {
            "question": "Do you provide support after the website is launched?",
            "answer": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Yes. We offer post-launch maintenance, content updates, and technical support to ensure your website continues to perform well."
                  }
                ]
              }
            ]
          },
          {
            "question": "Do you create responsive and eCommerce websites?",
            "answer": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Absolutely. Every site we build is fully responsive, and we also develop complete eCommerce stores with payment integration and custom product layouts."
                  }
                ]
              }
            ]
          },
          {
            "question": "Do you work with international clients?",
            "answer": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "text": "Yes — most of our work is international. Relyon Dev serves clients across the United States, United Kingdom, Europe, the Middle East and worldwide, working across time zones with updates over email or WhatsApp."
                  }
                ]
              }
            ]
          }
        ]
